# ============================================
# Supabase
# ============================================

# Your Supabase project URL (e.g., https://xxxx.supabase.co)
SUPABASE_URL=

# Public anon key — safe to use in client apps (read-only by default)
SUPABASE_ANON_KEY=

# Service role key — NEVER expose in client apps. Used server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Database
# ============================================

# Direct PostgreSQL connection string from Supabase (Settings > Database)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# ============================================
# Email (Gmail SMTP via Nodemailer)
# ============================================

# Gmail SMTP server — do not change unless using a different provider
SMTP_HOST=smtp.gmail.com

# Gmail SMTP port (587 = STARTTLS, 465 = SSL)
SMTP_PORT=587

# Gmail account used as the sender
SMTP_USER=vitacasahealthindia@gmail.com

# Gmail App Password (NOT the account password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the account
# Google displays it as 4 space-separated groups (e.g. "abcd efgh ijkl mnop")
# for readability only — paste it here with NO spaces, all 16 characters run
# together. A pasted-in space (or non-breaking space from a copy-paste) is
# part of the string nodemailer sends and Gmail will reject it as invalid.
SMTP_PASSWORD=

# ============================================
# Firebase (Push Notifications via FCM)
# ============================================

# Firebase project ID from Project Settings > General
FIREBASE_PROJECT_ID=

# Private key from the service account JSON (include the full key with newlines as \n)
FIREBASE_PRIVATE_KEY=

# Client email from the service account JSON
FIREBASE_CLIENT_EMAIL=

# ============================================
# MSG91 (SMS OTP — optional, only used when an admin enables OTP-based
# login/registration for an app via the Login Settings screen. The app
# boots and OTP send/verify DTOs validate fine without these; OtpService
# simply fails a send with AUTH_014 until they're set.)
# ============================================

# MSG91 auth key from the MSG91 dashboard
MSG91_AUTH_KEY=

# MSG91 OTP template ID (create an OTP template in the MSG91 dashboard first)
MSG91_TEMPLATE_ID=

# MSG91 approved sender ID (6 characters, e.g. "VITACR")
MSG91_SENDER_ID=

# ============================================
# App Configuration
# ============================================

# Port the NestJS API server listens on
API_PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Email address to receive admin notifications (new submissions, etc.)
ADMIN_NOTIFICATION_EMAIL=vitacasahealthindia@gmail.com

# ============================================
# JWT (Custom Auth)
# ============================================

# Random 256-bit secret for signing JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access token time-to-live in seconds, ADMIN WEB ONLY (default: 6 months).
# Caregiver-app access tokens never expire — see token.service.ts.
JWT_ACCESS_TOKEN_TTL=15552000

# Refresh token time-to-live in seconds (default: 30 days)
JWT_REFRESH_TOKEN_TTL=2592000
